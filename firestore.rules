rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, write: if request.auth.uid == userId;
    }
    match /acls/{role} {
      allow read: if true;
      allow write: if (!exists(/databases/$(database)/documents/acls/roles) && request.auth.uid != null) || get(/databases/$(database)/documents/acls/roles).data.admins.hasAny([request.auth.uid]);
    }
    match /systems/{systemId} {
      allow read: if true;
      allow write: if get(/databases/$(database)/documents/acls/roles).data.realms.systems.editors.hasAny([request.auth.uid]) || get(/databases/$(database)/documents/acls/roles).data.admins.hasAny([request.auth.uid]);
    }
    // Display names only, so people can be picked when sharing a timeline.
    match /profiles/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['displayName']);
    }

    // Personal timelines: owner has full control; roles[uid] is 'viewer' or 'editor';
    // linkAccess 'viewer' lets anyone signed in who knows the id view it.
    function canReadTimeline(t) {
      return request.auth != null && (
        t.owner == request.auth.uid
        || request.auth.uid in t.members
        || t.linkAccess == 'viewer');
    }
    function canEditTimeline(t) {
      return request.auth != null && (
        t.owner == request.auth.uid
        || (request.auth.uid in t.roles && t.roles[request.auth.uid] == 'editor'));
    }
    function validSharing(t) {
      return t.members.toSet() == t.roles.keys().toSet()
        && t.linkAccess in ['none', 'viewer'];
    }
    match /timelines/{timelineId} {
      allow read: if canReadTimeline(resource.data);
      allow create: if request.auth != null
        && request.resource.data.owner == request.auth.uid
        && validSharing(request.resource.data);
      allow update: if
        (resource.data.owner == request.auth.uid
          && request.resource.data.owner == resource.data.owner
          && validSharing(request.resource.data))
        || (canEditTimeline(resource.data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'updatedAt']));
      allow delete: if resource.data.owner == request.auth.uid;

      match /{sub}/{docId} {
        allow read: if canReadTimeline(get(/databases/$(database)/documents/timelines/$(timelineId)).data);
        allow write: if canEditTimeline(get(/databases/$(database)/documents/timelines/$(timelineId)).data);
      }
    }
    match /paths/{pathId} {
      allow read: if true;
      allow write: if get(/databases/$(database)/documents/acls/roles).data.realms.paths.editors.hasAny([request.auth.uid]) || get(/databases/$(database)/documents/acls/roles).data.admins.hasAny([request.auth.uid]);
    }
  }
}
